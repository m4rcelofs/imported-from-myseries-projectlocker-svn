  <!-- Servlets -->
  <servlet>
    <servlet-name>seriesServlet</servlet-name>
    <servlet-class>se.kth.myseries.server.series.SeriesServiceImpl</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>seriesServlet</servlet-name>
    <url-pattern>/myseries/series</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>friendsServlet</servlet-name>
    <servlet-class>se.kth.myseries.server.profiles.ProfilesServiceImpl</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>friendsServlet</servlet-name>
    <url-pattern>/myseries/friends</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>calendarServlet</servlet-name>
    <servlet-class>se.kth.myseries.server.watchlist.WatchlistServiceImpl</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>calendarServlet</servlet-name>
    <url-pattern>/myseries/calendar</url-pattern>
  </servlet-mapping>
  
  <!-- Default page to serve -->
  <welcome-file-list>
